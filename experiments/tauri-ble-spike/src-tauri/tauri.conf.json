{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ridrs BLE spike",
  "version": "0.0.1",
  "identifier": "org.ridrs.spike.ble",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ridrs BLE spike",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "Q89G28YBFK",
      "frameworks": ["CoreBluetooth"]
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
