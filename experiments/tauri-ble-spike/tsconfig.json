{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@ridrs/contracts": ["./../../packages/contracts/src/index.ts"],
      "@ridrs-shared/ftms-parser": ["./../../plugins/device-ftms-trainer/parser.ts"],
      "@ridrs-shared/ftms-trainer-plugin": ["./../../plugins/device-ftms-trainer/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
