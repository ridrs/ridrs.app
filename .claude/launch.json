{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "native-web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ridrs/native",
        "exec",
        "vite",
        "preview",
        "--port",
        "1420",
        "--strictPort"
      ],
      "port": 1420
    },
    {
      "name": "ux-draft",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "docs/ux-draft"
      ],
      "port": 4173
    },
    {
      "name": "native-web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@ridrs/native",
        "exec",
        "vite",
        "--port",
        "1431",
        "--strictPort"
      ],
      "port": 1431
    }
  ]
}
