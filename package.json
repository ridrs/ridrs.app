{
  "name": "ridrs",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && pnpm depcruise",
    "format": "biome format --write .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages plugins tests",
    "test:unit": "vitest run",
    "test:bdd": "NODE_OPTIONS=\"--import tsx\" cucumber-js && NODE_OPTIONS=\"--import tsx\" cucumber-js --profile ui",
    "test": "pnpm test:unit && pnpm test:bdd"
  },
  "dependencies": {
    "@ridrs/contracts": "workspace:*",
    "@ridrs/core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cucumber/cucumber": "13.3.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@ridrs/testing": "workspace:*",
    "@sinonjs/fake-timers": "15.4.0",
    "@testing-library/dom": "10.4.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "dependency-cruiser": "18.7.0",
    "execa": "10.2.1",
    "happy-dom": "21.0.4",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
