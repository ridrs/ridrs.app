{
  "format": "ridrs-workout",
  "version": 1,
  "id": "long-endurance-2x50",
  "name": "Long Endurance 2×50",
  "description": "The long ride indoors: two 50-minute blocks at 70 % FTP with a short break, then 15 minutes at 75 %. Fuel it like a long ride outside (60–90 g of carbohydrate per hour) and drink more than usual: indoors there is little airflow to cool you.",
  "sport": "virtual-ride",
  "author": "ridrs",
  "license": "CC-BY-SA-4.0",
  "category": "Endurance",
  "focus": "endurance",
