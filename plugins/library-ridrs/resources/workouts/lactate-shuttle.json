{
  "format": "ridrs-workout",
  "version": 1,
  "id": "lactate-shuttle",
  "name": "Lactate Shuttle",
  "description": "Over-unders: four 12-minute sets alternating 2 minutes at 90 % FTP and 1 minute at 110 %, with 5 easy minutes between sets. You hold a hard pace while recovering from surges above threshold, which is what a race asks of you.",
  "sport": "virtual-ride",
  "author": "ridrs",
  "license": "CC-BY-SA-4.0",
  "category": "Over-unders",
  "focus": "threshold",
