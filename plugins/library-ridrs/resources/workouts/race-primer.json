{
  "format": "ridrs-workout",
  "version": 1,
  "id": "race-primer",
  "name": "Race Primer",
  "description": "The day before a race or test: three high-cadence spin-ups, two 4-minute efforts at FTP and one 15-second sprint. Enough intensity to feel sharp, not enough to tire you.",
  "sport": "virtual-ride",
  "author": "ridrs",
  "license": "CC-BY-SA-4.0",
  "category": "Openers",
  "source": {
    "kind": "builtin",
    "format": "zwo",
    "fileName": "race-primer.zwo"
  },
  "steps": [
    {
      "kind": "interval",
      "id": "1",
      "intensity": "warm-up",
      "duration": {
        "kind": "time",
        "seconds": 900
      },
      "effort": {
        "kind": "target",
        "primary": {
          "unit": "percent-ftp",
          "start": {
            "low": 50,
            "high": 50
          },
          "end": {
            "low": 75,
            "high": 75
          }
        }
      },
      "cues": [
        {
          "offsetSeconds": 0,
          "text": "Roll in."
        }
      ],
      "extensions": {
        "zwo": {
          "element": "Warmup",
          "attributeOrder": [
            "Duration",
            "PowerLow",
            "PowerHigh"
          ]
        }
      }
    },
    {
      "kind": "interval",
      "id": "2",
      "duration": {
        "kind": "time",
        "seconds": 180
      },
      "effort": {
        "kind": "target",
        "primary": {
          "unit": "percent-ftp",
          "start": {
            "low": 50,
            "high": 50
          }
        }
      },
      "cues": [
        {
          "offsetSeconds": 0,
          "text": "Easy."
        },
        {
          "offsetSeconds": 165,
          "text": "Next: three spin-ups at 110 rpm."
        }
      ],
      "extensions": {
        "zwo": {
          "element": "SteadyState",
          "attributeOrder": [
            "Duration",
            "Power"
          ]
        }
      }
    },
    {
      "kind": "repeat",
      "id": "3",
      "until": {
        "kind": "count",
        "reps": 3
      },
      "steps": [
        {
          "kind": "interval",
          "id": "3.1",
          "intensity": "interval",
          "duration": {
            "kind": "time",
            "seconds": 30
          },
          "effort": {
            "kind": "target",
            "primary": {
              "unit": "percent-ftp",
              "start": {
                "low": 115,
                "high": 115
              }
            },
            "secondary": [
              {
                "unit": "rpm",
                "start": {
                  "low": 110,
                  "high": 110
                }
              }
            ]
          }
        },
        {
          "kind": "interval",
          "id": "3.2",
          "intensity": "recovery",
          "duration": {
            "kind": "time",
            "seconds": 90
          },
          "effort": {
            "kind": "target",
            "primary": {
              "unit": "percent-ftp",
              "start": {
                "low": 60,
                "high": 60
              }
            },
            "secondary": [
              {
                "unit": "rpm",
                "start": {
                  "low": 85,
                  "high": 85
                }
              }
            ]
          }
        }
      ],
      "extensions": {
        "zwo": {
          "element": "IntervalsT",
          "attributeOrder": [
            "Repeat",
            "OnDuration",
            "OffDuration",
            "OnPower",
            "OffPower",
            "Cadence",
            "CadenceResting"
          ]
        }
      }
    },
    {
      "kind": "interval",
      "id": "4",
      "duration": {
        "kind": "time",
        "seconds": 180
      },
      "effort": {
        "kind": "target",
        "primary": {
          "unit": "percent-ftp",
          "start": {
            "low": 60,
            "high": 60
          }
        }
      },
      "cues": [
        {
          "offsetSeconds": 0,
          "text": "Easy."
        },
        {
          "offsetSeconds": 165,
          "text": "Next: 2 × 4 minutes at FTP. Race pace, controlled."
        }
      ],
      "extensions": {
        "zwo": {
          "element": "SteadyState",
          "attributeOrder": [
            "Duration",
            "Power"
          ]
        }
      }
    },
    {
      "kind": "repeat",
      "id": "5",
      "until": {
        "kind": "count",
        "reps": 2
      },
      "steps": [
        {
          "kind": "interval",
          "id": "5.1",
          "intensity": "interval",
          "duration": {
            "kind": "time",
            "seconds": 240
          },
          "effort": {
            "kind": "target",
            "primary": {
              "unit": "percent-ftp",
              "start": {
                "low": 100,
                "high": 100
              }
            }
          }
        },
        {
          "kind": "interval",
          "id": "5.2",
          "intensity": "recovery",
          "duration": {
            "kind": "time",
            "seconds": 240
          },
          "effort": {
            "kind": "target",
            "primary": {
              "unit": "percent-ftp",
              "start": {
                "low": 60,
                "high": 60
              }
            }
          }
        }
      ],
      "extensions": {
        "zwo": {
          "element": "IntervalsT",
          "attributeOrder": [
            "Repeat",
            "OnDuration",
            "OffDuration",
            "OnPower",
            "OffPower"
          ]
        }
      }
    },
    {
      "kind": "interval",
      "id": "6",
      "duration": {
        "kind": "time",
        "seconds": 120
      },
      "effort": {
        "kind": "target",
        "primary": {
          "unit": "percent-ftp",
          "start": {
            "low": 60,
            "high": 60
          }
        }
      },
      "cues": [
        {
          "offsetSeconds": 0,
          "text": "Easy."
        },
        {
          "offsetSeconds": 105,
          "text": "Next: one 15-second sprint, out of the saddle."
        }
      ],
      "extensions": {
        "zwo": {
          "element": "SteadyState",
          "attributeOrder": [
            "Duration",
            "Power"
          ]
        }
      }
    },
    {
      "kind": "interval",
      "id": "7",
      "duration": {
        "kind": "time",
        "seconds": 15
      },
      "effort": {
        "kind": "target",
        "primary": {
          "unit": "percent-ftp",
          "start": {
            "low": 150,
            "high": 150
          }
        },
        "secondary": [
          {
            "unit": "rpm",
            "start": {
              "low": 110,
              "high": 110
            }
          }
        ]
      },
      "cues": [
        {
          "offsetSeconds": 0,
          "text": "Full gas."
        }
      ],
      "extensions": {
        "zwo": {
          "element": "SteadyState",
          "attributeOrder": [
            "Duration",
            "Power",
            "Cadence"
          ]
        }
      }
    },
    {
      "kind": "interval",
      "id": "8",
      "intensity": "cool-down",
      "duration": {
        "kind": "time",
        "seconds": 600
      },
      "effort": {
        "kind": "target",
        "primary": {
          "unit": "percent-ftp",
          "start": {
            "low": 50,
            "high": 50
          },
          "end": {
            "low": 35,
            "high": 35
          }
        }
      },
      "cues": [
        {
          "offsetSeconds": 0,
          "text": "Done. Keep the rest of the day easy."
        }
      ],
      "extensions": {
        "zwo": {
          "element": "Cooldown",
          "attributeOrder": [
            "Duration",
            "PowerLow",
            "PowerHigh"
          ]
        }
      }
    }
  ],
  "extensions": {
    "zwo": {
      "elementOrder": [
        "author",
        "name",
        "description",
        "sportType",
        "workout"
      ],
      "sportType": "bike"
    }
  }
}
