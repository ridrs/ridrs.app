{
  "format": "ridrs-workout",
  "version": 1,
  "id": "oxygen-thief",
  "name": "Oxygen Thief 7×4",
  "description": "Seven 4-minute VO2max efforts that start with 45 seconds at 135 % FTP, then hold 115 %. The fast start raises oxygen uptake sooner, so more of each rep is spent near VO2max. 3½ easy minutes between reps, zone 2 to finish.",
  "sport": "virtual-ride",
  "author": "ridrs",
  "license": "CC-BY-SA-4.0",
  "category": "VO2max",
  "focus": "vo2max",
