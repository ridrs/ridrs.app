{
  "format": "ridrs-workout",
  "version": 1,
  "id": "gentle-waves",
  "name": "Gentle Waves",
  "description": "Zone 2 with some movement: three 15-minute waves rising from 60 to 70 % FTP, 5 easy minutes after each, then 20 steady minutes at 65 %. Aerobic volume, less monotony than a flat line.",
