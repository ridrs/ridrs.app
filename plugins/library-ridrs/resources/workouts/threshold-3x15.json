{
  "format": "ridrs-workout",
  "version": 1,
  "id": "threshold-3x15",
  "name": "Threshold Foundation 3×15",
  "description": "Three 15-minute blocks at 98 % FTP and 85–95 rpm with 5 easy minutes between them. Close to your limit but sustainable; if you can't hold the power, take 2–3 % off and finish the block.",
  "sport": "virtual-ride",
  "author": "ridrs",
  "license": "CC-BY-SA-4.0",
  "category": "Threshold",
  "focus": "threshold",
  "source": {
    "kind": "builtin",
    "format": "zwo",
    "fileName": "threshold-3x15.zwo"
  },
  "steps": [
    {
      "kind": "interval",
      "id": "1",
      "intensity": "warm-up",
      "duration": {
        "kind": "time",
        "seconds": 1200
      },
      "effort": {
        "kind": "target",
        "primary": {
          "unit": "percent-ftp",
          "start": {
            "low": 50,
            "high": 50
          },
          "end": {
            "low": 75,
            "high": 75
          }
        }
      },
      "cues": [
        {
          "offsetSeconds": 0,
          "text": "Roll in."
        },
        {
          "offsetSeconds": 1185,
          "text": "Next: 3 × 15 minutes at threshold. Pace the first one."
        }
      ],
      "extensions": {
        "zwo": {
          "element": "Warmup",
          "attributeOrder": [
            "Duration",
            "PowerLow",
            "PowerHigh"
          ]
        }
      }
    },
    {
      "kind": "repeat",
      "id": "2",
      "until": {
        "kind": "count",
        "reps": 3
      },
      "steps": [
        {
          "kind": "interval",
          "id": "2.1",
          "intensity": "interval",
          "duration": {
            "kind": "time",
            "seconds": 900
          },
          "effort": {
            "kind": "target",
            "primary": {
              "unit": "percent-ftp",
              "start": {
                "low": 98,
                "high": 98
              }
            },
            "secondary": [
              {
                "unit": "rpm",
                "start": {
                  "low": 85,
                  "high": 95
                }
              }
            ]
          }
        },
        {
          "kind": "interval",
          "id": "2.2",
          "intensity": "recovery",
          "duration": {
            "kind": "time",
            "seconds": 300
          },
          "effort": {
            "kind": "target",
            "primary": {
              "unit": "percent-ftp",
              "start": {
                "low": 50,
                "high": 50
              }
            }
          }
        }
      ],
      "extensions": {
        "zwo": {
          "element": "IntervalsT",
          "attributeOrder": [
            "Repeat",
            "OnDuration",
            "OffDuration",
            "OnPower",
            "OffPower",
            "CadenceLow",
            "CadenceHigh"
          ]
        }
      }
    },
    {
      "kind": "interval",
      "id": "3",
      "intensity": "cool-down",
      "duration": {
        "kind": "time",
        "seconds": 600
      },
      "effort": {
        "kind": "target",
        "primary": {
          "unit": "percent-ftp",
          "start": {
            "low": 50,
            "high": 50
          },
          "end": {
            "low": 35,
            "high": 35
          }
        }
      },
      "cues": [
        {
          "offsetSeconds": 0,
          "text": "Spin down."
        }
      ],
      "extensions": {
        "zwo": {
          "element": "Cooldown",
          "attributeOrder": [
            "Duration",
            "PowerLow",
            "PowerHigh"
          ]
        }
      }
    }
  ],
  "extensions": {
    "zwo": {
      "elementOrder": [
        "author",
        "name",
        "description",
        "sportType",
        "workout"
      ],
      "sportType": "bike"
    }
  }
}
