<workout_file>
  <author>ridrs</author>
  <name>Endurance 75 with drills</name>
  <description>Steady endurance with a high-cadence drill of 2 minutes at the end of each 17-minute block, and a free ride of 5 minutes.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="540" PowerLow="0.50" PowerHigh="0.68"/>
    <SteadyState Duration="900" Power="0.68"><textevent timeoffset="0" message="Steady and relaxed"/></SteadyState>
    <SteadyState Duration="120" Power="0.68" CadenceLow="105" CadenceHigh="115"><textevent timeoffset="0" message="Spin it up: 105-115 rpm, stay smooth"/></SteadyState>
    <SteadyState Duration="900" Power="0.68"><textevent timeoffset="0" message="Steady and relaxed"/></SteadyState>
    <SteadyState Duration="120" Power="0.68" CadenceLow="105" CadenceHigh="115"><textevent timeoffset="0" message="Spin it up: 105-115 rpm, stay smooth"/></SteadyState>
    <SteadyState Duration="900" Power="0.68"><textevent timeoffset="0" message="Steady and relaxed"/></SteadyState>
    <SteadyState Duration="120" Power="0.68" CadenceLow="105" CadenceHigh="115"><textevent timeoffset="0" message="Spin it up: 105-115 rpm, stay smooth"/></SteadyState>
    <FreeRide Duration="300"><textevent timeoffset="0" message="Free ride: ride by feel"/></FreeRide>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
