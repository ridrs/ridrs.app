<workout_file>
  <author>ridrs</author>
  <name>Gentle Waves</name>
  <description>Zone 2 with some movement: three 15-minute waves rising from 60 to 70 % FTP, 5 easy minutes after each, then 20 steady minutes at 65 %. Aerobic volume, less monotony than a flat line.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.60">
      <textevent timeoffset="0" message="Roll in."/>
    </Warmup>
    <Ramp Duration="900" PowerLow="0.60" PowerHigh="0.70">
      <textevent timeoffset="0" message="Wave 1 of 3: a slow rise to 70 %. Breathing stays easy."/>
    </Ramp>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Ease off. Good moment to drink."/>
    </SteadyState>
    <Ramp Duration="900" PowerLow="0.60" PowerHigh="0.70">
      <textevent timeoffset="0" message="Wave 2 of 3."/>
    </Ramp>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Ease off."/>
    </SteadyState>
    <Ramp Duration="900" PowerLow="0.60" PowerHigh="0.70">
      <textevent timeoffset="0" message="Wave 3 of 3."/>
    </Ramp>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Ease off."/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.65">
      <textevent timeoffset="0" message="20 minutes steady. Smooth, even pedalling."/>
    </SteadyState>
    <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Spin down."/>
    </Cooldown>
  </workout>
</workout_file>
