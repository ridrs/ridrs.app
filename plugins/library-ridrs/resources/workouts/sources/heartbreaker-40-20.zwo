<workout_file>
  <author>ridrs</author>
  <name>Heartbreaker 40/20</name>
  <description>Three sets of fourteen 40/20s at 115, 118 and 120 % FTP, 5 minutes between sets, then 15 minutes of zone 2. Each set a little harder than the last.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.65">
      <textevent timeoffset="0" message="Roll in."/>
      <textevent timeoffset="585" message="Next: three 10-second primers."/>
    </Warmup>
    <IntervalsT Repeat="3" OnDuration="10" OffDuration="50" OnPower="1.50" OffPower="0.50"/>
    <SteadyState Duration="180" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
      <textevent timeoffset="165" message="Next: set 1 of 3. Find the rhythm."/>
    </SteadyState>
    <IntervalsT Repeat="14" OnDuration="40" OffDuration="20" OnPower="1.15" OffPower="0.50"/>
    <SteadyState Duration="300" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
      <textevent timeoffset="285" message="Next: set 2 of 3, a little harder."/>
    </SteadyState>
    <IntervalsT Repeat="14" OnDuration="40" OffDuration="20" OnPower="1.18" OffPower="0.50"/>
    <SteadyState Duration="300" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
      <textevent timeoffset="285" message="Next: set 3 of 3. This is where it counts."/>
    </SteadyState>
    <IntervalsT Repeat="14" OnDuration="40" OffDuration="20" OnPower="1.20" OffPower="0.50"/>
    <SteadyState Duration="120" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.65">
      <textevent timeoffset="0" message="Zone 2 by heart rate: adjust the power if needed."/>
    </SteadyState>
    <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.35">
      <textevent timeoffset="0" message="Spin down."/>
    </Cooldown>
  </workout>
</workout_file>
