<workout_file>
  <author>ridrs</author>
  <name>VO2max 4×4</name>
  <description>Four 4-minute efforts at 115 % FTP with 4 easy minutes between them: the classic VO2max set in under an hour. Aim for even power across all four; the last should be hard, not a fight.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.70">
      <textevent timeoffset="0" message="Roll in."/>
    </Warmup>
    <SteadyState Duration="240" Power="0.65">
      <textevent timeoffset="0" message="Settle in."/>
      <textevent timeoffset="225" message="Next: 4 × 4 minutes. Even pacing across all four."/>
    </SteadyState>
    <IntervalsT Repeat="4" OnDuration="240" OffDuration="240" OnPower="1.15" OffPower="0.50"/>
    <Cooldown Duration="420" PowerLow="0.50" PowerHigh="0.35">
      <textevent timeoffset="0" message="Spin down."/>
    </Cooldown>
  </workout>
</workout_file>
