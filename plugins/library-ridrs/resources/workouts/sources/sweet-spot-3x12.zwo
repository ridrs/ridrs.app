<workout_file>
  <author>ridrs</author>
  <name>Sweet Spot 3×12</name>
  <description>The short classic: three 12-minute blocks at 90 % FTP with 4 easy minutes between them. Hard but sustainable; a lot of aerobic work for an hour.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75">
      <textevent timeoffset="0" message="Roll in."/>
      <textevent timeoffset="585" message="Next: 3 × 12 minutes. Hard, but sustainable."/>
    </Warmup>
    <IntervalsT Repeat="3" OnDuration="720" OffDuration="240" OnPower="0.90" OffPower="0.55"/>
    <Cooldown Duration="300" PowerLow="0.65" PowerHigh="0.45">
      <textevent timeoffset="0" message="Spin down."/>
    </Cooldown>
  </workout>
</workout_file>
