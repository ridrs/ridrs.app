<workout_file>
  <author>ridrs</author>
  <name>VO2max 30/15</name>
  <description>Short intervals after Rønnestad's 30/15 protocol: three sets of thirteen 30-second efforts at 120 % FTP with 15 seconds easy, then 20 minutes of zone 2. The short rests keep oxygen uptake high, so you collect a lot of time near VO2max.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="1200" PowerLow="0.45" PowerHigh="0.70">
      <textevent timeoffset="0" message="Roll in."/>
      <textevent timeoffset="1185" message="Next: two openers."/>
    </Warmup>
    <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" OnPower="1.10" OffPower="0.50"/>
    <SteadyState Duration="120" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
      <textevent timeoffset="105" message="Next: set 1 of 3, 13 × 30/15."/>
    </SteadyState>
    <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.20" OffPower="0.50"/>
    <SteadyState Duration="300" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
      <textevent timeoffset="285" message="Next: set 2 of 3."/>
    </SteadyState>
    <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.20" OffPower="0.50"/>
    <SteadyState Duration="300" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
      <textevent timeoffset="285" message="Next: set 3 of 3, the last one."/>
    </SteadyState>
    <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.20" OffPower="0.50"/>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Easy."/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.68">
      <textevent timeoffset="0" message="Zone 2 by heart rate: adjust the power if needed."/>
    </SteadyState>
    <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.35">
      <textevent timeoffset="0" message="Spin down."/>
    </Cooldown>
  </workout>
</workout_file>
