<workout_file>
  <author>ridrs</author>
  <name>Half Hour Twice</name>
  <description>Long tempo: two 30-minute blocks at 83 % FTP with 5 easy minutes between them. Breathing deeper but under control; it should feel steady, not like a threshold effort.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.70">
      <textevent timeoffset="0" message="Easy spin to open the legs."/>
      <textevent timeoffset="885" message="Next: 2 × 30 minutes tempo. Settle in, don't chase it."/>
    </Warmup>
    <SteadyState Duration="1800" Power="0.83">
      <textevent timeoffset="0" message="Block 1 of 2: breathing deeper, still controlled."/>
      <textevent timeoffset="900" message="Halfway."/>
      <textevent timeoffset="1500" message="Last 5 minutes."/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Easy."/>
    </SteadyState>
    <SteadyState Duration="1800" Power="0.83">
      <textevent timeoffset="0" message="Block 2 of 2. Same rhythm as the first."/>
      <textevent timeoffset="900" message="Halfway."/>
      <textevent timeoffset="1500" message="Last 5 minutes."/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Easy."/>
    </SteadyState>
    <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Spin down."/>
    </Cooldown>
  </workout>
</workout_file>
