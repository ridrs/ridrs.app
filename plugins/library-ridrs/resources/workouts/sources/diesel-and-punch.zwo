<workout_file>
  <author>ridrs</author>
  <name>Diesel and Punch</name>
  <description>Two 20-minute sweet-spot blocks at 90 % FTP, then twenty 30/30s at 135 %. The 30/30s come on tired legs, like surges late in a race.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.70">
      <textevent timeoffset="0" message="Roll in."/>
    </Warmup>
    <SteadyState Duration="120" Power="0.50">
      <textevent timeoffset="0" message="Next: 2 × 20 minutes sweet spot."/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.90">
      <textevent timeoffset="0" message="Block 1 of 2: smooth and steady."/>
      <textevent timeoffset="600" message="Halfway."/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.90">
      <textevent timeoffset="0" message="Block 2 of 2. Same pressure, stay patient."/>
      <textevent timeoffset="600" message="Halfway."/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.50">
      <textevent timeoffset="0" message="Easy."/>
      <textevent timeoffset="285" message="Next: 20 × 30/30. Hard on, really easy off."/>
    </SteadyState>
    <IntervalsT Repeat="20" OnDuration="30" OffDuration="30" OnPower="1.35" OffPower="0.50"/>
    <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.35">
      <textevent timeoffset="0" message="Spin down. Solid work."/>
    </Cooldown>
  </workout>
</workout_file>
