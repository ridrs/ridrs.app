<workout_file>
  <author>ridrs</author>
  <name>Long Endurance 2×50</name>
  <description>The long ride indoors: two 50-minute blocks at 70 % FTP with a short break, then 15 minutes at 75 %. Fuel it like a long ride outside (60–90 g of carbohydrate per hour) and drink more than usual: indoors there is little airflow to cool you.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.40" PowerHigh="0.65">
      <textevent timeoffset="0" message="Roll in. Food and bottles within reach."/>
    </Warmup>
    <SteadyState Duration="3000" Power="0.70">
      <textevent timeoffset="0" message="Block 1 of 2: a pace you could hold all day."/>
      <textevent timeoffset="1200" message="Eat and drink."/>
      <textevent timeoffset="2400" message="Eat and drink."/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Short break: sit up, stretch, drink."/>
    </SteadyState>
    <SteadyState Duration="3000" Power="0.70">
      <textevent timeoffset="0" message="Block 2 of 2. Same pace; shift your position now and then."/>
      <textevent timeoffset="1200" message="Eat and drink."/>
      <textevent timeoffset="2400" message="Eat and drink."/>
    </SteadyState>
    <SteadyState Duration="300" Power="0.55">
      <textevent timeoffset="0" message="Short break."/>
    </SteadyState>
    <SteadyState Duration="900" Power="0.75">
      <textevent timeoffset="0" message="Last 15 minutes: a little more, still conversational."/>
    </SteadyState>
    <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40">
      <textevent timeoffset="0" message="Spin down. Long one done."/>
    </Cooldown>
  </workout>
</workout_file>
