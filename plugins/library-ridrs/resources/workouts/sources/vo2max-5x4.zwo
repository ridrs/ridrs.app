<workout_file>
  <author>ridrs</author>
  <name>VO2max 5×4</name>
  <description>Five 4-minute efforts at 115 % FTP with 95-105 rpm, each followed by 4 minutes easy.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
    <IntervalsT Repeat="5" OnDuration="240" OffDuration="240" OnPower="1.15" OffPower="0.50" CadenceLow="95" CadenceHigh="105"/>
    <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
