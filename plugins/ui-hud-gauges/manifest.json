{
  "id": "ui-hud-gauges",
  "name": "Gauge HUD",
  "version": "0.1.0",
  "types": [
    "ui"
  ],
  "provides": [],
  "requires": [],
  "entry": "index.ts",
  "ui": {
    "client": "client/index.tsx",
    "contributions": [
      {
        "id": "hud",
        "extensionPoint": "activity/hud",
        "export": "GaugeHud",
        "order": 0,
        "extensionPoints": [
          "hud/widget"
        ]
      },
      {
        "id": "telemetry",
        "extensionPoint": "activity/hud",
        "export": "Telemetry",
        "order": 1
      },
      {
        "id": "ride",
        "extensionPoint": "activity/hud",
        "export": "RideFacts",
        "order": 2
      },
      {
        "id": "route",
        "extensionPoint": "activity/hud",
        "export": "RouteBox",
        "order": 3
      }
    ],
    "events": {
      "subscribe": [
        "metric.power",
        "metric.heart-rate",
        "metric.cadence",
        "activity.state-changed",
        "activity.athlete",
        "physics.state",
        "world.position"
      ],
      "publish": []
    },
    "state": [
      "app.language",
      "athlete.profile",
      "data.source",
      "route.offer"
    ]
  }
