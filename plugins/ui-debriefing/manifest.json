{
  "id": "ui-debriefing",
  "name": "Ride Debriefing",
  "version": "0.1.0",
  "types": [
    "ui"
  ],
  "provides": [],
  "requires": [],
  "entry": "index.ts",
  "ui": {
    "client": "client/index.tsx",
    "screens": [
      {
        "id": "debriefing",
        "export": "DebriefingScreen"
      }
    ],
    "events": {
      "subscribe": [
        "activity.athlete",
        "activity.state-changed"
      ],
      "publish": [
        "activity.finish-requested",
        "activity.workout-requested",
        "activity.world-requested"
      ]
    },
    "state": [
      "app.language",
      "app.link",
      "athlete.profile",
      "data.source",
      "export.fit",
      "recording.ride",
      "route.offer",
      "training.account",
      "training.calendar",
      "training.library",
      "training.upload",
      "trash.item"
    ],
    "calls": [
      "recording.delete",
      "training.connect",
      "training.upload"
    ]
  }
}
