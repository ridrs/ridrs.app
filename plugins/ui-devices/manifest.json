{
  "id": "ui-devices",
  "name": "Devices",
  "version": "0.1.0",
  "types": [
    "ui"
  ],
  "provides": [],
  "requires": [],
  "entry": "index.ts",
  "ui": {
    "client": "client/index.tsx",
    "screens": [
      {
        "id": "setup",
        "export": "DeviceSetup",
        "extensionPoints": [
          "setup/companion"
        ]
      }
    ],
    "contributions": [
      {
        "id": "devices",
        "extensionPoint": "main/tile",
        "export": "DevicesTile"
      },
      {
        "id": "status",
        "extensionPoint": "main/action",
        "export": "DevicesAction"
      }
    ],
    "events": {
      "subscribe": [
        "activity.state-changed",
        "metric.power",
        "metric.heart-rate",
        "controller.buttons-changed",
        "trainer.control-changed"
      ],
      "publish": []
    },
    "state": [
      "bridge.state",
      "device.status"
    ],
    "calls": [
      "bridge.connect",
      "bridge.forget",
      "device.connect",
      "device.discover",
      "device.forget"
    ]
  }
}
