{
  "title": "ridrs recording v1 record",
  "description": "One line of a ridrs recording (application/vnd.ridrs.recording+json-seq; compression=gzip). See ridrs-recording-v1.md.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "header"
        },
        "format": {
          "type": "string",
          "const": "ridrs.recording"
        },
        "formatVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "ridrsVersion": {
          "type": "string"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "number"
        },
        "timeZoneOffsetMinutes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "platform": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "string",
              "enum": [
                "node",
                "tauri"
              ]
            },
            "os": {
              "type": "string"
            },
            "appVersion": {
              "type": "string"
            }
          },
          "required": [
            "runtime",
            "os",
            "appVersion"
          ],
          "additionalProperties": {}
        },
        "prerollMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "format",
        "formatVersion",
        "ridrsVersion",
        "sessionId",
        "startedAt",
        "timeZoneOffsetMinutes",
        "platform",
        "prerollMs"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "snapshot"
        },
        "host": {
          "$ref": "#/$defs/__schema0"
        },
        "sections": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "kind",
        "host",
        "sections"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "event"
        },
        "seq": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "preroll": {
          "type": "boolean"
        },
        "envelope": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string"
            },
            "timestamp": {
              "type": "number"
            },
            "payload": {},
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "input": {
              "type": "boolean",
              "const": true
            },
            "receivedAt": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "type",
            "source",
            "timestamp",
            "payload"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "kind",
        "seq",
        "preroll",
        "envelope"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "diagnostic"
        },
        "seq": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "at": {
          "type": "number"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "pluginId": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "kind",
        "seq",
        "at",
        "code",
        "message"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "footer"
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "recovered"
          ]
        },
        "endedAt": {
          "type": "number"
        },
        "lastSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "counts": {
          "type": "object",
          "properties": {
            "events": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "diagnostics": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "byType": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "required": [
            "events",
            "diagnostics",
            "byType"
          ],
          "additionalProperties": {}
        }
      },
      "required": [
        "kind",
        "status",
        "endedAt",
        "lastSeq",
        "counts"
      ],
      "additionalProperties": {}
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
