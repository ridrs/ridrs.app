{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ridrs companion",
  "version": "0.1.0",
  "identifier": "org.ridrs.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ridrs companion",
        "width": 420,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "backgroundColor": "#101418",
        "theme": "Dark",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "frameworks": ["CoreBluetooth"]
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
