{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC (channels); app files below $APPDATA/recordings and $APPDATA/training, settings below $APPDATA/config, read only: replacing and flushing go through the app_file_* commands (storage-files-tauri, ADR 0054); the save dialog of exported workouts (files-save-tauri, ADR 0085), whose chosen file the dialog adds to the fs scope, so no folder is allowed for it here; HTTP to the intervals.icu API, the relay (ADR 0079; the sign-in result at its exact URL), its sign-in page in the system browser and the loopback redirect server (ADR 0049). The app-local ble_*, keep_awake, app_file_* and secret_* commands need no plugin permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/recordings"
        },
        {
          "path": "$APPDATA/recordings/**"
        },
        {
          "path": "$APPDATA/training"
        },
        {
          "path": "$APPDATA/training/**"
        },
        {
          "path": "$APPDATA/config"
        },
        {
          "path": "$APPDATA/config/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/recordings"
        },
        {
          "path": "$APPDATA/training"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$APPDATA/recordings"
        },
        {
          "path": "$APPDATA/training"
        },
        {
          "path": "$APPDATA/config"
        },
        {
          "path": "$APPDATA/config/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$APPDATA/recordings/**"
        },
        {
          "path": "$APPDATA/training/**"
        },
        {
          "path": "$APPDATA/config/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPDATA/recordings/**"
        },
        {
          "path": "$APPDATA/training/**"
        },
        {
          "path": "$APPDATA/config/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/recordings/**"
        },
        {
          "path": "$APPDATA/training/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPDATA/recordings/**"
        },
        {
          "path": "$APPDATA/training/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA/recordings/**"
        },
        {
          "path": "$APPDATA/training/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://intervals.icu/api/*"
        },
        {
          "url": "https://ridrs.app/intervals/oauth/result"
        },
        {
          "url": "https://ridrs.app/devices"
        },
        {
          "url": "https://ridrs.app/devices/*"
        },
        {
          "url": "https://ridrs.app/updates"
        },
        {
          "url": "https://ridrs.app/updates?*"
        },
        {
          "url": "https://ridrs.app/updates/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://intervals.icu/oauth/authorize*"
        },
        {
          "url": "https://github.com/ridrs/ridrs.app*"
        }
      ]
    },
    "oauth:allow-start",
    "oauth:allow-cancel",
    "deep-link:allow-get-current",
    "websocket:allow-connect",
    "websocket:allow-send"
  ]
}
