{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ridrs",
  "version": "0.1.0",
  "identifier": "org.ridrs.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ridrs",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#101418",
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ridrs-media: http://ridrs-media.localhost https://tiles.openfreemap.org https://ridrs.app; media-src 'self' ridrs-media: http://ridrs-media.localhost; connect-src 'self' ipc: http://ipc.localhost ridrs-media: http://ridrs-media.localhost https://tiles.openfreemap.org; worker-src 'self' blob:; child-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["ridrs"] },
      "mobile": [{ "scheme": ["ridrs"], "appLink": false }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "frameworks": ["CoreBluetooth"]
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
