{
  "name": "video2gpx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Strassenvideo ohne GPS rein, GPX mit passenden Zeitstempeln raus (Beta).",
  "scripts": {
    "dev": "vite --port 1450 --strictPort",
    "build": "tsc --noEmit && vite build && rm -rf dist/mock",
    "preview": "vite preview --port 1450 --strictPort",
    "tauri": "tauri",
    "ui-shots": "node scripts/ui-shots.mjs",
    "test:ui": "node --test tests/*/*.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/leaflet": "^1.9.12",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
