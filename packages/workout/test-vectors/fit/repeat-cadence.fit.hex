# A FIT workout file, written by hand from the public FIT protocol and profile 21.218:
# "VO2max 5x4": warm-up, 5 × (4 min at 115 % FTP with 95–105 rpm, 4 min at 50 %), cool-down.

# File header: 14 bytes, protocol 2.0, profile 21.218, data size, ".FIT", header CRC
0e 20 u16:21218 {size} 2e 46 49 54 {hcrc}

# Definition, local type 0: file_id (0), little-endian; type enum, manufacturer uint16, time_created uint32
40 00 00 u16:0 03   00 01 00   01 02 84   04 04 86
# file_id: type 5 (workout), manufacturer 255 (development), time created
00 05 u16:255 u32:1100000000

# Definition, local type 1: workout (26); sport, sub_sport, num_valid_steps, wkt_name (16 bytes)
41 00 00 u16:26 04   04 01 00   0b 01 00   06 02 84   08 10 07
# workout: cycling (2), indoor_cycling (6), 5 steps
01 02 06 u16:5 str16"VO2max 5x4"

# Definition, local type 2: workout_step (27) with 13 fields
42 00 00 u16:27 0d
  fe 02 84   # message_index uint16
  00 0c 07   # wkt_step_name string[12]
  01 01 00   # duration_type enum
  02 04 86   # duration_value uint32
  03 01 00   # target_type enum
  04 04 86   # target_value uint32
  05 04 86   # custom_target_value_low uint32
  06 04 86   # custom_target_value_high uint32
  07 01 00   # intensity enum
  13 01 00   # secondary_target_type enum
  14 04 86   # secondary_target_value uint32
  15 04 86   # secondary_custom_target_value_low uint32
  16 04 86   # secondary_custom_target_value_high uint32

# Data, local type 2, one per step:
#  idx     name               dur type, value   target type, value, low, high    intensity  secondary type, value, low, high
02 u16:0 str12"Warm up"   00 u32:600000     04 u32:0 u32:55 u32:65               02         ff ff ff ff ff ff ff ff ff ff ff ff ff
02 u16:1 str12"On"        00 u32:240000     04 u32:0 u32:115 u32:115             05         03 u32:0 u32:95 u32:105
02 u16:2 str12"Off"       00 u32:240000     04 u32:0 u32:50 u32:50               04         ff ff ff ff ff ff ff ff ff ff ff ff ff
# repeat_until_steps_cmplt (6): back to step 1, 5 times (target_value)
02 u16:3 str12""          06 u32:1          ff u32:5 ff ff ff ff ff ff ff ff     ff         ff ff ff ff ff ff ff ff ff ff ff ff ff
02 u16:4 str12"Cool down" 00 u32:600000     02 ff ff ff ff ff ff ff ff ff ff ff ff 03       ff ff ff ff ff ff ff ff ff ff ff ff ff

# File CRC
{crc}
