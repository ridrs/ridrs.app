<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
    <author>ridrs test vectors</author>
    <name>Intervals, free ride and max effort</name>
    <description>IntervalsT with cadence, a free ride on a flat road, a ramp and a sprint.</description>
    <sportType>bike</sportType>
    <workout>
        <SteadyState Duration="300" Power="0.55"/>
        <IntervalsT Repeat="5" OnDuration="45" OffDuration="75" OnPower="1.2" OffPower="0.5" Cadence="100" CadenceResting="80"/>
        <FreeRide Duration="300" FlatRoad="1"/>
        <Ramp Duration="180" PowerLow="0.6" PowerHigh="1.1" CadenceLow="85" CadenceHigh="95"/>
        <MaxEffort Duration="20"/>
        <FreeRide Duration="120" FlatRoad="0"/>
        <SteadyState Duration="300" Power="0.07"/>
    </workout>
</workout_file>
