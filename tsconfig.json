{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@ridrs/ble-bridge": ["./packages/ble-bridge/src/index.ts"],
      "@ridrs/ble-peripheral": ["./packages/ble-peripheral/src/index.ts"],
      "@ridrs/ble-simulator": ["./packages/ble-simulator/src/index.ts"],
      "@ridrs/ble-tauri": ["./packages/ble-tauri/src/index.ts"],
      "@ridrs/contracts": ["./packages/contracts/src/index.ts"],
      "@ridrs/core": ["./packages/core/src/index.ts"],
      "@ridrs/core/node": ["./packages/core/src/node/index.ts"],
      "@ridrs/fit": ["./packages/fit/src/index.ts"],
      "@ridrs/metric-source": ["./packages/metric-source/src/index.ts"],
      "@ridrs/presentation": ["./packages/presentation/src/index.ts"],
      "@ridrs/replay": ["./packages/replay/src/index.ts"],
      "@ridrs/recording": ["./packages/recording/src/index.ts"],
      "@ridrs/temporal": ["./packages/temporal/src/index.ts"],
      "@ridrs/testing": ["./packages/testing/src/index.ts"],
      "@ridrs/ui-bridge": ["./packages/ui-bridge/src/index.ts"],
      "@ridrs/ui-preview": ["./packages/ui-preview/src/index.ts"],
      "@ridrs/ui-sdk": ["./packages/ui-sdk/src/index.ts"],
      "@ridrs/ui-sdk/react": ["./packages/ui-sdk/src/react.ts"],
      "@ridrs/ui-shell": ["./packages/ui-shell/src/index.ts"],
      "@ridrs/workout": ["./packages/workout/src/index.ts"]
    }
  },
  "include": [
    "apps/companion/scripts/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "scripts/check-video-routes.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web",
    "experiments",
    "apps/native/src-tauri",
    "apps/companion/src-tauri"
  ]
}
