{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tests/**",
      "*.ts",
      "*.mjs",
      "*.cjs",
      "*.json",
      "!node_modules",
      "!dist",
      "!web",
      "!experiments"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
